# =============================================================================
# agent_team isolated-runtime — environment defaults
#
# ⚠️ WHERE DO THESE GO? Two different .env files — don't mix them up:
#
#   • Everything EXCEPT `OPENSANDBOX_BIND_ADDR` configures the APP. Copy those
#     lines into the agent-manager repo-root .env  (agent-manager/.env) — the
#     FastAPI process reads them there (core/config.py: load_dotenv + env_file).
#
#   • `OPENSANDBOX_BIND_ADDR` (bottom of this file) is the ONLY variable the
#     docker-compose server reads. `cp .env.example .env` inside infra/runtime/
#     creates the compose .env; compose substitutes just that one variable and
#     ignores all the AGENT_TEAM_RUNTIME_* / OPEN_SANDBOX_* lines.
#
# These are the PROCESS-WIDE defaults; a board can override the tuning fields
# (provider/strategy/image/cpu/…) from Board settings → Runtime, which overlays
# on top of these.
#
# Nothing here is required: with AGENT_TEAM_RUNTIME_PROVIDER unset (or "local")
# the plugin behaves exactly as before (CLI agents run on the host).
# Resolution order: run request → task → board → these env defaults.
# =============================================================================

# ── Provider gate ────────────────────────────────────────────────────────────
# "local"       → run CLI agents on the host (default, no isolation).
# "opensandbox" → run each task in its own isolated OpenSandbox container.
AGENT_TEAM_RUNTIME_PROVIDER=local

# ── OpenSandbox server connection (only used when provider=opensandbox) ───────
# Base URL of the OpenSandbox API server (see docker-compose.opensandbox.yml).
OPEN_SANDBOX_DOMAIN=http://127.0.0.1:8090
# Opaque bearer token the server checks. Leave empty for local dev when the
# server binds 127.0.0.1 only; set a random string in prod.
OPEN_SANDBOX_API_KEY=

# ── Execution strategy ───────────────────────────────────────────────────────
# "oneshot"     → non-interactive print-mode command per turn.
# "acp_sidecar" → in-sandbox server owns the ACP process, bridges the full ACP
#                 frame stream to the host over WebSocket. Both strategies use the
#                 same runtime-full image (the sidecar is baked in).
AGENT_TEAM_RUNTIME_STRATEGY=oneshot
AGENT_TEAM_RUNTIME_SIDECAR_PORT=8871

# ── Image & resources ────────────────────────────────────────────────────────
AGENT_TEAM_RUNTIME_IMAGE=agent-team/runtime-full:latest
# Optional pre-baked snapshot id to launch from instead of a cold image.
AGENT_TEAM_RUNTIME_SNAPSHOT=
AGENT_TEAM_RUNTIME_CPU=2
AGENT_TEAM_RUNTIME_MEMORY_MB=4096

# ── Lifecycle timeouts (minutes / seconds) ───────────────────────────────────
AGENT_TEAM_RUNTIME_TIMEOUT_MINUTES=180
# Idle sandboxes are paused after this many minutes to free resources.
AGENT_TEAM_RUNTIME_IDLE_MINUTES=30
AGENT_TEAM_RUNTIME_READY_TIMEOUT_SECONDS=60

# ── Workspace ────────────────────────────────────────────────────────────────
# "mount" → bind the host task workspace into the sandbox.
# "sync"  → copy files in/out around each turn.
AGENT_TEAM_RUNTIME_WORKSPACE_MODE=mount
AGENT_TEAM_RUNTIME_WORKSPACE_PATH=/workspace

# ── Isolation policy ─────────────────────────────────────────────────────────
# When true, a task NEVER falls back to host execution if the sandbox fails.
AGENT_TEAM_RUNTIME_STRICT=false
# When true, allow silently falling back to host execution on sandbox errors.
AGENT_TEAM_RUNTIME_ALLOW_FALLBACK=false
# Route sandbox traffic through the OpenSandbox server proxy.
AGENT_TEAM_RUNTIME_SERVER_PROXY=true
# Comma-separated env var names to strip before they reach the sandbox.
AGENT_TEAM_RUNTIME_ENV_BLOCKLIST=

# ── Warm pool (optional) ─────────────────────────────────────────────────────
AGENT_TEAM_RUNTIME_POOL_ENABLED=false
AGENT_TEAM_RUNTIME_POOL_MAX_IDLE=1

# ── Interface OpenSandbox publishes 8090 on ──────────────────────────────────
# THE ONLY variable the docker-compose server reads → belongs in the compose
# .env (infra/runtime/.env), NOT the app .env. The app never uses it.
# 127.0.0.1 = local/dev only. Use 0.0.0.0 only behind a reverse proxy/tunnel.
OPENSANDBOX_BIND_ADDR=127.0.0.1
