# =============================================================================
# OpenSandbox server configuration for the agent_team isolated runtime.
#
# TEMPLATE — copy to config.toml (which is gitignored) and fill in secrets:
#   cp opensandbox/config.toml.example opensandbox/config.toml
#
# Schema matches the upstream sample:
#   https://github.com/alibaba/OpenSandbox/blob/main/server/docker-compose.example.yaml
#
# Mounted into the server container at /etc/opensandbox/config.toml by
# docker-compose.opensandbox.yml.
# =============================================================================

[server]
host = "0.0.0.0"
port = 8090
# SECRET — set a random string in prod; must match OPEN_SANDBOX_API_KEY in the
# agent-manager .env. Leave commented for local dev bound to 127.0.0.1.
# api_key = "REPLACE_WITH_A_RANDOM_SECRET"

[log]
level = "INFO"

[runtime]
type = "docker"
# Tags: https://hub.docker.com/r/opensandbox/execd/tags
execd_image = "opensandbox/execd:v1.0.20"

[egress]
# Tags: https://hub.docker.com/r/opensandbox/egress/tags
image = "opensandbox/egress:v1.1.3"
# "dns+nft" is REQUIRED for the Credential Vault (credentialProxy.enabled) used
# by claude backend="vault". Plain "dns" works for env/mount backends but the
# server rejects a credential proxy request. Deny-default network policies are
# also only enforced under nft. Keep "dns+nft" so both work.
mode = "dns+nft"

[docker]
# Spawn sandbox containers on the SAME docker network as the server so the
# server can reach them (Linux isolation).
#
# ⚠️ Network-policy trade-off: OpenSandbox only enforces a `networkPolicy`
# (deny-default egress / allow_hosts) when sandboxes run on the plain "bridge"
# network. On a user-defined network like below, ANY networkPolicy request is
# rejected ("networkPolicy is not supported when docker network_mode=..."). The
# app handles this by sending no policy in allow-all mode (the default). If you
# later want deny-default/allow_hosts, set network_mode = "bridge" here.
network_mode = "agent-team-runtime"
host_ip = "host.docker.internal"
drop_capabilities = [
    "AUDIT_WRITE",
    "MKNOD",
    "NET_ADMIN",
    "NET_RAW",
    "SYS_ADMIN",
    "SYS_MODULE",
    "SYS_PTRACE",
    "SYS_TIME",
    "SYS_TTY_CONFIG",
]
no_new_privileges = true
# Bump to 4096+ in prod to avoid "can't start new thread" under load.
pids_limit = 4096

[ingress]
mode = "direct"

[storage]
# Allowlist of host path PREFIXES that may be bind-mounted into a sandbox
# (workspace mode = "mount", and credential mount backend). A bind mount is
# REJECTED if the host path is not under one of these prefixes.
#
# ⚠️ MUST include BOTH:
#   1) the app's task-workspaces root, e.g. the parent of paths like
#      /home/<user>/agent-manager/workspaces/agent_team/agent-team/T-42
#      → add "/home/<user>/agent-manager/workspaces"
#   2) the AI Code Factory login/config dirs the mount backend injects for
#      claude/codex (the environment's `config_dir`, e.g. "/home/<user>/.claude",
#      "/home/<user>/.codex").
# The simplest single-tenant option is to allow the whole home: "/home/<user>".
# Paths refer to the REAL host filesystem (the server spawns sibling containers
# via the docker socket). Edit here, then restart the server.
allowed_host_paths = [
    "/var/www",
    "/workspace",
    "/var/lib/agent-team/credentials",
    # "/home/chizy/agent-manager/workspaces",
    # "/home/chizy/.claude",
    # "/home/chizy/.codex",
]
